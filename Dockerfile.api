# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,id=npm-cache,target=/root/.npm \
  npm ci --prefer-offline --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=production
EXPOSE 4000

CMD ["npm", "run", "api"]
